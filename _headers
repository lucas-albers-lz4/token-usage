/*
  GitHub Pages headers — served for every path on this site.
  CSP: everything from 'self'; no inline scripts/styles, no external fonts/CDNs.
*/
/*
  F5 hardening (housekeeping audit): lock the page down.
*/
Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
X-Content-Type-Options: nosniff
Referrer-Policy: no-referrer
